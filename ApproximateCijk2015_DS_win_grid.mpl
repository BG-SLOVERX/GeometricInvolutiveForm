with(LieAlgebrasOfVectorFields):
interface(typesetting=extended):
with(Typesetting,Suppress,Settings):
with(PDEtools,DeterminingPDE):
Settings(userep=true):

Digits := 15;

Deriv := proc(L, vars) local newL, l, v, nder; newL := []; for l in L do for v in vars do nder := diff(l, v); if not member(nder, newL) then newL := [op(newL), nder]; end if; end do; end do; newL; end proc:
Prolong := proc(sys::list, vars, r) local i, j, T, P, dordsys, dord; dordsys := PDEtools[difforder](sys); for i to nops(sys) do dord := PDEtools[difforder](sys[i]); P[i] := sys[i]; T := sys[i]; for j to r + dordsys - dord do T := op(Deriv([T], vars)); P[i] := P[i], T; end do; end do; return [seq(P[i], i = 1 .. nops(sys))]; end proc:

PommaretRankingMtx := proc(indeps, deps) local n, m, i, j, RM; n := nops(indeps); m := nops(deps); RM := Matrix(n + m, n + m, datatype = integer[8]); for j to n do RM[1, j] := 1; end do; for j from n + 1 to n + m do RM[1, j] := 0; end do; for i from 2 to n do RM[i, i - 1] := -1; end do; for i from n + 1 to n + m do RM[i, i] := 1; end do; return convert(RM, listlist); end proc:
MatrixFormPDE := proc(R, {ranking::list := false}) local N, dOrder, indep, dep, sys, n, m, nJet, jetVars, dummyVars, subsList, sysWithDummies, A, trash, j; N := (n, m, d) -> m*binomial(n + d, d); dOrder := PDETools:-difforder(GetSystem(R)); indep := GetIndependents(R); dep := GetDependents(R, 'output' = "names"); sys := GetSystem(R); n := nops(indep); m := nops(dep); nJet := N(n, m, dOrder); userinfo(3, 'GeometricInvolutiveBasis', "Input system has order ", dOrder); if ranking = false then jetVars := DEtools[checkrank](map(u -> u(op(indep)), dep), dep, ':-indep' = indep, 'degree' = dOrder); else userinfo(3, 'GeometricInvolutiveBasis', "User defined ranking = ", ranking); jetVars := DEtools[checkrank](map(u -> u(op(indep)), dep), dep, ':-indep' = indep, 'degree' = dOrder, ':-ranking' = ranking); end if; jetVars := ListTools:-Reverse(jetVars); if nops(jetVars) <> nJet then error "Number of jet variables should be %1 but was actually %2,  %3", nJet, nops(jetVars), jetVars; end if; dummyVars := [seq(a[j], j = 1 .. nJet)]; subsList := zip(`=`, jetVars, dummyVars); sysWithDummies := subs(subsList, sys); A, trash := LinearAlgebra:-GenerateMatrix(sysWithDummies, dummyVars); return A, jetVars; end proc:
GeoInvBasis := proc(A, vardeg::[list(name), list({name, function}), nonnegint], {tol::nonnegative := TOL, randomPoint::list(numeric) := true}) local numRank, d, UU, sigma, VVt, j, k, r, dimKer, C, Brsp, Bker, dimKerCheck, dimKerCheckL, ks, n, m, N, Nd, Nc, B, randInt, randPoint, generatePoint, indeps, deps, dimSymb, rankSymb, dj, sumbeta, beta, numpr, maxpr, BetaM, SpaceM, RankSymM, BrspM, BkerM, SigmaM, DimKerM, DimRspM, DataTypeSpec, BetaMaxM, rowd, cold, Asymspan, Asym, RankAsym, Ncd, DimSymM, SymM; global TOL, RANDPT; Nd := (n, m, d) -> m*binomial(n + d - 1, d); N := (n, m, d) -> m*binomial(n + d, d); Nc := (n, m, d, k) -> N(n - k, m, d - 1); Ncd := (n, m, d, k) -> add(Nc(n, m, d, ks), ks = 1 .. k - 1); numRank := proc(sigma::Vector, tol::nonnegative) return nops(select(x -> tol < x, convert(sigma, list))); end proc; randInt := rand(90000 .. 100000); generatePoint := proc() local j; return [seq(evalf(1/100000*randInt()), j = 1 .. n)]; end proc; indeps := vardeg[1]; deps := vardeg[2]; d := vardeg[3]; maxpr := 0; numpr := 0; n := nops(indeps); m := nops(deps); if Digits < 15 then WARNING("To take advantage of hardware floats, should set Digits := 15, currently Digits is %1", Digits); end if; if Digits <= 15 then DataTypeSpec := float[8]; else WARNING("Currently Digits=", Digits, "With Digits>15, the code will execute in the higher number of digits using software floats"); DataTypeSpec := anything; end if; if LinearAlgebra:-ColumnDimension(A) <> N(n, m, d) then error "invalid input: Input matrix has %1 columns, but should have %2 columns", LinearAlgebra:-ColumnDimension(A), N(n, m, d); end if; userinfo(2, 'GeometricInvolutiveBasis', "You have entered a matrix for", LinearAlgebra:-RowDimension(A), "eqns with system degree", d, ", independent vars", indeps, ", dependent vars", deps); if randomPoint = false then randPoint := generatePoint(); elif nops(RANDPT) <> n then error "invalid input: Expected point spec with %1 components, but received %2", n, randomPoint; else randPoint := RANDPT; end if; tol; randPoint := zip(`=`, indeps, evalf(randPoint)); userinfo(5, 'GeometricInvolutiveBasis', "randPoint = ", randPoint); DimKerM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); DimRspM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); SigmaM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); RankSymM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); DimSymM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); SymM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); BrspM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); BkerM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); BetaM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); BetaMaxM := Matrix(1 .. maxpr + 1, 1 .. d + 1, datatype = anything, fill = ` `); B := Matrix(convert(evalf(subs(randPoint, A)), listlist), datatype = DataTypeSpec, storage = rectangular); userinfo(5, 'GeometricInvolutiveBasis', "Matrix form evaluated at rand. point:", print(B)); UU[d], sigma[d], VVt[d] := LinearAlgebra:-SingularValues(B, output = ['U', 'S', 'Vt'], outputoptions['Vt'] = [datatype = DataTypeSpec, storage = rectangular]); userinfo(5, 'GeometricInvolutiveBasis', " Leaving SVD at iteration for degree = ", d); lprint(tol); r := numRank(sigma[d], tol); dimKer[d] := N(n, m, d) - r; DimKerM[numpr + 1, d + 1] := dimKer[d]; DimRspM[numpr + 1, d + 1] := r; SigmaM[numpr + 1, d + 1] := sigma[d]; Brsp[d] := VVt[d][1 .. r]; Bker[d] := VVt[d][r + 1 .. N(n, m, d)]; BrspM[numpr + 1, d + 1] := Brsp[d]; BkerM[numpr + 1, d + 1] := Bker[d]; C := VVt[d][r + 1 .. N(n, m, d), 1 .. N(n, m, d - 1)]; for j from d - 1 by -1 to 0 do userinfo(5, 'GeometricInvolutiveBasis', "Starting iteration for degree = ", j - 1); UU[j], sigma[j], VVt[j] := LinearAlgebra:-SingularValues(C, output = ['U', 'S', 'Vt'], outputoptions['Vt'] = [datatype = DataTypeSpec, storage = rectangular]); userinfo(5, 'GeometricInvolutiveBasis', "Leaving iteration for degree = ", j - 1); r := numRank(sigma[j], tol); dimKer[j] := r; DimKerM[numpr + 1, j + 1] := dimKer[j]; DimRspM[numpr + 1, j + 1] := N(n, m, j) - r; dimSymb[j + 1] := dimKer[j + 1] - dimKer[j]; DimSymM[numpr + 1, j + 2] := dimSymb[j + 1]; rankSymb[j + 1] := Nd(n, m, j + 1) - dimSymb[j + 1]; RankSymM[numpr + 1, j + 2] := rankSymb[j + 1]; Bker[j] := VVt[j][1 .. r]; Brsp[j] := VVt[j][r + 1 .. N(n, m, j)]; BkerM[numpr + 1, j + 1] := Bker[j]; BrspM[numpr + 1, j + 1] := Brsp[j]; SigmaM[numpr + 1, j + 1] := sigma[j]; C := VVt[j][1 .. r, 1 .. N(n, m, j - 1)]; end do; dimSymb[0] := dimKer[0]; DimSymM[numpr + 1, 1] := dimSymb[0]; rankSymb[0] := Nd(n, m, 0) - dimSymb[0]; RankSymM[numpr + 1, 1] := rankSymb[0]; for dj from d by -1 to 0 do sumbeta := 0; beta := NULL; for k from n by -1 to 1 do if Nc(n, m, dj, k) <= rankSymb[dj] - sumbeta then beta := Nc(n, m, dj, k), beta; sumbeta := sumbeta + Nc(n, m, dj, k); elif rankSymb[dj] - sumbeta < Nc(n, m, dj, k) and sumbeta < rankSymb[dj] then beta := rankSymb[dj] - sumbeta, beta; sumbeta := rankSymb[dj]; else beta := 0, beta; end if; end do; j := 'j'; BetaMaxM[numpr + 1, dj + 1] := [[beta], sum(j*[beta][j], j = 1 .. n)]; end do; beta := 'beta'; for dj from d by -1 to 1 do rowd, cold := LinearAlgebra:-Dimensions(BrspM[numpr + 1, dj + 1]); if rowd = 0 then BetaM[numpr + 1, dj + 1] := [[seq(0, j = 1 .. n)], 0]; SymM[numpr + 1, dj + 1] := BrspM[numpr + 1, dj + 1][1 .. rowd, N(n, m, dj - 1) + 1 .. N(n, m, dj)]; else Asymspan := BrspM[numpr + 1, dj + 1][1 .. rowd, N(n, m, dj - 1) + 1 .. N(n, m, dj)]; SymM[numpr + 1, dj + 1] := BrspM[numpr + 1, dj + 1][1 .. rowd, N(n, m, dj - 1) + 1 .. N(n, m, dj)]; if LinearAlgebra:-ColumnDimension(Asymspan) <> Nd(n, m, dj) then error `Col dimension of Asymspan <> Nd(n,m,dj) `; end if; Asym[n] := Asymspan[1 .. rowd, Ncd(n, m, dj, n) + 1 .. Nd(n, m, dj)]; sigma[n] := LinearAlgebra:-SingularValues(Asym[n], output = ['S'], outputoptions['S'] = [datatype = DataTypeSpec, storage = rectangular]); RankAsym[n] := numRank(sigma[n], tol); beta[n] := RankAsym[n]; for k from n by -1 to 2 do Asym[k - 1] := Asymspan[1 .. rowd, Ncd(n, m, dj, k - 1) + 1 .. Nd(n, m, dj)]; sigma[k - 1] := LinearAlgebra:-SingularValues(Asym[k - 1], output = ['S'], outputoptions['S'] = [datatype = DataTypeSpec, storage = rectangular]); RankAsym[k - 1] := numRank(sigma[k - 1], tol); beta[k - 1] := RankAsym[k - 1] - RankAsym[k]; end do; j := 'j'; BetaM[numpr + 1, dj + 1] := [[seq(beta[j], j = 1 .. n)], sum(j*beta[j], j = 1 .. n)]; end if; end do; BetaM[numpr + 1, 1] := [[seq(0, j = 1 .. n)], 0]; rowd, cold := LinearAlgebra:-Dimensions(BrspM[numpr + 1, 1]); SymM[numpr + 1, 1] := BrspM[numpr + 1, 1][1 .. rowd, 1 .. N(n, m, dj)]; SpaceM := Matrix(1 .. numpr + 1, 1 .. d + 1, (i, j) -> Pi^(d + 1 - j)*D^(i - 1)*R); return table([DimKerMtx = DimKerM, DimRspMtx = DimRspM, SigmaMtx = SigmaM, BrspMtx = BrspM, BkerMtx = BkerM, DimSymMtx = DimSymM, SymMtx = SymM, RankSymMtx = RankSymM, BetaMaxMtx = BetaMaxM, BetaMtx = BetaM]); end proc:
ExtractSlice := proc(G, d::nonnegint) local i, idx, gTable; i := d + 1; gTable := table(); for idx in map(op, [indices(G)]) do gTable[idx] := G[idx][1, i]; end do; return op(gTable); end proc:

NumericalCijk := proc(V, R, jPr::nonnegint, q::posint, {randomPoint::list(scalar) := false, tol::nonnegative := TOL}, $) local N, indeps, deps, X, n, m, prOrder, dSys, dOrd, A, G, jetVars, involutiveSysInfo, oneDownSysInfo, nJetQ, nJetQ1, jetVarsQ, jetVarsQ1, UQ, UQ1, projectedUQ, extendedNullVectors, derivOperatorsQ, derivOperatorsQ1, jetQ, jetQPrime, jetsOfBracket, subsList, xi, dummyDep, XPrime, Y, i, j, k, r, w, C, RealW, ErrorW, ew, rew; global TOL, RANDPT; N := (n, m, d) -> m*binomial(n + d, d); jPr; q; randomPoint; indeps := GetIndependents(R); X := V; deps := GetDependents(R); n := nops(indeps); m := nops(deps); prOrder := jPr; tol; if randomPoint <> false and nops(randomPoint) <> n then error "invalid input: Expected %1 components of randomPoint, but received list %2 with %3 components", n, randomPoint, nops(randomPoint); end if; dSys := LHPDE(Prolong(GetSystem(R), indeps, jPr), indep = indeps, dep = deps); dOrd := PDETools:-difforder(R) + jPr; A, jetVarsQ := MatrixFormPDE(dSys, indeps, deps, 'ranking' = PommaretRankingMtx(indeps, deps)); G := GeoInvBasis(A, [indeps, deps, dOrd], 'tol' = tol, 'randomPoint' = randomPoint); involutiveSysInfo := ExtractSlice(G, q); oneDownSysInfo := ExtractSlice(G, q - 1); nJetQ := N(n, m, q); nJetQ1 := N(n, m, q - 1); UQ := LinearAlgebra:-Transpose(involutiveSysInfo['BkerMtx']); UQ1 := LinearAlgebra:-Transpose(oneDownSysInfo['BkerMtx']); projectedUQ := UQ[1 .. nJetQ1, () .. ()]; extendedNullVectors := UQ . (LinearAlgebra[LinearAlgebra:-MatrixInverse]((LinearAlgebra:-Transpose(UQ1)) . projectedUQ)); dummyDep := [seq(xi[i](op(indeps)), i = 1 .. n)]; XPrime := VectorField('space' = indeps, 'components' = dummyDep); Y := LieBracket(X, XPrime); jetVarsQ1 := jetVarsQ[1 .. nJetQ1]; derivOperatorsQ := LieAlgebrasOfVectorFields:-VFPDO(jetVarsQ, X); derivOperatorsQ1 := LieAlgebrasOfVectorFields:-VFPDO(jetVarsQ1, X); jetQ := derivOperatorsQ(X); jetQPrime := derivOperatorsQ(XPrime); jetsOfBracket := derivOperatorsQ1(Y); r := LinearAlgebra:-ColumnDimension(UQ); w := Matrix(r, r); for i to r do for j from i + 1 to r do subsList := [op(zip(`=`, jetQ, convert(LinearAlgebra:-Column(extendedNullVectors, i), list))), op(zip(`=`, jetQPrime, convert(LinearAlgebra:-Column(extendedNullVectors, j), list)))]; w[i, j] := convert(eval(subs(subsList, jetsOfBracket)), Vector); end do; for j to i - 1 do w[i, j] := -w[j, i]; end do; w[i, i] := Vector(r, 'shape' = 'zero'); end do; C := Array(1 .. r, 1 .. r, 1 .. r); for k to r do for i to r do for j from i + 1 to r do C[i, j, k] := LinearAlgebra:-DotProduct(LinearAlgebra:-Column(UQ1, k), w[i, j]); end do; for j to i - 1 do C[i, j, k] := -C[j, i, k]; end do; C[i, i, k] := 0; end do; end do; RealW := Matrix(r, r); ErrorW := Matrix(r, r); for i to r do for j from i + 1 to r do for k to r do RealW[i, j] := RealW[i, j] + C[i, j, k]*LinearAlgebra:-Column(UQ1, k); end do; ErrorW[i, j] := LinearAlgebra:-Norm(RealW[i, j] - w[i, j]); end do; for j to i - 1 do RealW[i, j] := -RealW[j, i]; ErrorW[i, j] := -ErrorW[j, i]; end do; end do; ew := LinearAlgebra:-Norm(ErrorW); if LinearAlgebra:-Norm(RealW) <> 0 then rew := ew/LinearAlgebra:-Norm(RealW); else if ew = 0 then rew := 0; else rew := infinity; end if; end if; return C, w, RealW, ErrorW, ew, rew; end proc:
StructureInfo := proc(Eqs, i, DEdimensionInfo)
                local NonlinearDE, DetEqs, X, R, C, w, rw, EW, ew, rew;
                
                if type(DEdimensionInfo[2],integer)=true and type(DEdimensionInfo[4],integer)=true then
                
                NonlinearDE := Eqs:
                DetEqs := DeterminingPDE(NonlinearDE, [xi(x, y), eta(x, y)], integrabilityconditions = false);
                X := VectorField(xi(x,y)*D[x] + eta(x,y)*D[y], space=[x,y]):
                R := LHPDE(convert(DetEqs,list), indep=[x,y], dep=[xi,eta]);

                # RANDPT := DEdimensionInfo[6];

                C, w, rw, EW, ew, rew := NumericalCijk(X, R, DEdimensionInfo[4], DEdimensionInfo[5], randomPoint = DEdimensionInfo[6], tol = 0.10e-10):

                return [i, DEdimensionInfo[6], ew, rew, DisplayStructure(C, 'X')]:
                end if;
                end proc:

targetde := diff(y(x),x,x) + 0.708203932*y(x)*diff(y(x),x) + 5*y(x)^3 + exp(-10((x-1)^2+(y(x)-1)^2));

TOL := 0.1e-10:

for j from 1 to nops(DEdimInfo) do

RANDPT := DEdimInfo[j][6]:

# for i from -2 to 50 do

#     StructureInfoList[j][i] := StructureInfo(de[i],i,DEdimInfo[j][i]);
# end do;

StructureInfoList[j] := StructureInfo(targetde, 1 ,DEdimInfo[j]);

end do;

save StructureInfoList, "targetresultfg1gridtol11-0-6-e10.m":